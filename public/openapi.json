{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Healthcare Platform - API Specification",
    "description": "Consolidated interactive API documentation across all Smart Healthcare microservices: Auth, User Profile, Health Data, and ML Prediction.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "",
      "description": "Smart Healthcare Edge Reverse Proxy Gateway"
    }
  ],
  "tags": [
    {
      "name": "1. Auth & Identity Service",
      "description": "Registration, Verification, JWT Authentication, and OAuth2/OIDC Tokens (Port 8081)"
    },
    {
      "name": "2. User Profile Service",
      "description": "Patient Demographics, Clinical History, and Doctor Assignment (Port 8082)"
    },
    {
      "name": "3. Health Data Service",
      "description": "Longitudinal Biometric Vitals, Sensor Telemetry, and Lab Records (Port 8083)"
    },
    {
      "name": "4. ML Prediction Service",
      "description": "Cardiometabolic Risk Inference, Multi-Disease Scoring, and PDF Reports (Port 8085)"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "1. Auth & Identity Service"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ping": {
      "get": {
        "tags": [
          "1. Auth & Identity Service"
        ],
        "summary": "Returns the service name and status",
        "operationId": "ping",
