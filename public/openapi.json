          "weightKg": {
            "type": "number",
            "format": "double",
            "maximum": 350,
            "minimum": 20
          },
          "bmi": {
            "type": "number",
            "format": "double"
          },
          "systolicBp": {
            "type": "integer",
            "format": "int32",
            "maximum": 260,
            "minimum": 60
          },
          "diastolicBp": {
            "type": "integer",
            "format": "int32",
            "maximum": 160,
            "minimum": 40
          },
          "fastingGlucoseMgDl": {
            "type": "number",
            "format": "double"
          },
          "hba1cPercent": {
            "type": "number",
            "format": "double"
          },
          "totalCholesterolMgDl": {
            "type": "number",
            "format": "double"
          },
          "hdlMgDl": {
            "type": "number",
