              }
            }
          }
        }
      }
    },
    "/auth/verify-email": {
      "get": {
        "tags": [
          "1. Auth & Identity Service"
        ],
        "operationId": "verifyEmail",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/oauth2/token": {
      "post": {
        "tags": [
          "1. Auth & Identity Service"
        ],
        "summary": "OAuth2 / OIDC Token Endpoint (Issue JWT Access Token)",
        "description": "Issues access tokens using authorization_code, refresh_token, or client_credentials grants.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Token issued successfully"
          }
        }
      }
    },
    "/oauth2/jwks": {
      "get": {
        "tags": [
          "1. Auth & Identity Service"
        ],
        "summary": "JSON Web Key Set (JWKS Public Keys)",
        "description": "Public RSA keys used by microservices to verify JWT digital signatures.",
        "responses": {
          "200": {
            "description": "JWK Set with RSA public keys"
          }
        }
      }
    },
